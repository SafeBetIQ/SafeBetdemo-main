# ============================================================================
# SafeBet IQ — Environment Variables Reference
# ============================================================================
# Copy this file to .env.local for local development.
# For CI/CD: set real values in Amplify Console environment variables.
#
# CLASSIFICATION:
#   NEXT_PUBLIC_*  → embedded in browser bundle (safe for public values only)
#   All others     → server-side only, never sent to the browser
#
# DO NOT commit .env.local, .env.demo, or .env.production to git.
# Only .env.example (this file, containing placeholders) is committed.
# ============================================================================

# ── Identity ────────────────────────────────────────────────────────────────
# Values: "demo" | "production" | "local"
NEXT_PUBLIC_ENV=local
NEXT_PUBLIC_APP_NAME=SafeBet IQ (Local)

# ── Supabase ─────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# SERVER-ONLY — Supabase service role (admin access). NEVER prefix NEXT_PUBLIC_.
# Used only in server-side API routes or Server Actions.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── API ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# ── AWS / Disaster Recovery (server-side) ───────────────────────────────────
AWS_REGION=af-south-1
NEXT_PUBLIC_REGION=af-south-1
NEXT_PUBLIC_DR_REGION=eu-west-1

DR_AWS_REGION=eu-west-1
DR_S3_REGION=eu-west-1
DR_S3_BUCKET=<your-backup-bucket>
DR_S3_PREFIX=backups/local/
DR_LOG_GROUP=/aws/lambda/safebet-rds-failover
DR_CW_NAMESPACE=SafeBetIQ/Local
DR_ROUTE53_HEALTH_CHECK_ID=<optional>

CLOUDWATCH_NAMESPACE=SafeBetIQ/Local
S3_BACKUP_BUCKET=<your-backup-bucket>
FAILOVER_ENABLED=false

# ── AWS IAM credentials (server-only) ───────────────────────────────────────
# Prefer Amplify execution role over static keys in production.
# AWS_ACCESS_KEY_ID=<your-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

# ── Messaging / Twilio (server-only) ────────────────────────────────────────
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_WHATSAPP_NUMBER=<e.g. +14155238886>
TWILIO_SMS_NUMBER=<your-sms-number>

# ── SafePlay Connect API (server-only) ──────────────────────────────────────
SAFEPLAY_API_KEY=<your-api-key>
SAFEPLAY_WEBHOOK_SECRET=<your-webhook-secret>

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Get from: https://dash.cloudflare.com → Turnstile → Add site
# Site key is PUBLIC — safe to expose in browser bundle
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-turnstile-site-key>
# Secret key is SERVER-ONLY — used in /api/contact route to verify tokens
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>

# ── Internal HMAC Signing (server-only) ──────────────────────────────────────
# Must match the value stored in Supabase Vault as "risk_engine_hmac_secret"
# Retrieve: SELECT decrypted_secret FROM vault.decrypted_secrets WHERE name = 'risk_engine_hmac_secret'
# Set in: Dashboard → Edge Functions → Secrets → RISK_ENGINE_HMAC_SECRET
RISK_ENGINE_HMAC_SECRET=<retrieve-from-vault>
