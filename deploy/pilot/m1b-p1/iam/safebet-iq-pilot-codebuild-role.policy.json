{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PilotCodeBuildLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:eu-west-1:046276255259:log-group:/aws/codebuild/safebet-iq-pilot-node20-build",
        "arn:aws:logs:eu-west-1:046276255259:log-group:/aws/codebuild/safebet-iq-pilot-node20-build:*"
      ]
    },
    {
      "Sid": "PilotBuildArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::safebet-iq-pilot-build",
        "arn:aws:s3:::safebet-iq-pilot-build/*",
        "arn:aws:s3:::elasticbeanstalk-eu-west-1-046276255259",
        "arn:aws:s3:::elasticbeanstalk-eu-west-1-046276255259/codebuild/safebet-iq-pilot-node20-build/*"
      ]
    }
  ]
}
