# SafeBet IQ — Environment Variables Template
#
# Copy this file to:
#   .env.local        → local development (gitignored)
#   .env.demo         → demo environment values (gitignored)
#   .env.production   → production environment values (gitignored)
#
# NEVER commit real keys. This file contains placeholders only.
# Both variables are REQUIRED — the app will throw on startup if either is missing.

# Supabase project URL (from: Supabase Dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase anon/public key (from: Supabase Dashboard → Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
