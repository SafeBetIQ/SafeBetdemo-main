# ── Pilot operational monitoring (ORR-1A / WS4) ──────────────────────────────
# Enables CloudWatch Logs streaming + Enhanced Health for the Elastic Beanstalk
# environment. Pilot-appropriate: gives operators application/nginx logs and
# instance/environment health in CloudWatch without over-engineering.
# CPU / 5xx / latency ALARMS require an environment-specific SNS topic and are
# provisioned per the ORR-1A monitoring report + go-live checklist (they are
# not hard-coded here because the notification target is environment-specific).

option_settings:
  # Stream EB platform + application logs to CloudWatch Logs (14-day retention).
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 14
  # Stream Enhanced Health events to CloudWatch Logs.
  aws:elasticbeanstalk:cloudwatch:logs:health:
    HealthStreamingEnabled: true
    RetentionInDays: 14
  # Enhanced health reporting (per-instance CPU/mem/latency/5xx visibility).
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
  # Load-balancer / instance health check hits the lightweight liveness probe.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /api/health
