# Build the Next.js app ON the Elastic Beanstalk instance (Node.js 20) so the
# .next runtime matches the platform Node version. Building locally under a
# different Node major produces a .next whose app-page runtime is incompatible
# ("Cannot read properties of undefined (reading 'workers')"), so the build must
# happen here. NPM_CONFIG_PRODUCTION=false installs the devDependencies that
# `next build` needs (tailwind/postcss/typescript). The 2 GB swap (00_swap)
# provides build headroom.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NPM_CONFIG_PRODUCTION: "false"
    NODE_OPTIONS: "--max-old-space-size=1536"

container_commands:
  01_next_build:
    command: "npm run build:eb"
    leader_only: true
