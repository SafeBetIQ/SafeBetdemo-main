# dependencies
node_modules
frontend/node_modules
.pnp
.pnp.js

# testing
coverage

# next.js
.next/
frontend/.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit real credentials
.env
.env*.local
.env.demo
.env.production
